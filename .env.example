# =============================================================================
# CalmMama Village — environment variables for local dev & Render deployment
# Copy to .env for local use. In Render: add the same keys under Environment.
# =============================================================================

# --- Runtime (Node production server) ----------------------------------------
# Render assigns PORT automatically — do not hardcode in production.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# --- Expo web build-time (embedded during `npm run build`) -------------------
# Render: buildCommand must be `npm run build` (expo export --platform web).
# Do NOT set startCommand to `expo start` or `npm start` — that serves dev Hermes bundles.
# Stripe publishable key for checkout UI (pk_live_... or pk_test_...)
# Must be set before `expo export` runs on Render so it is baked into the bundle.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# --- Optional / future backend integrations ----------------------------------
# Not wired in the client-only app today — document for upcoming server routes.
# DATABASE_URL=postgresql://user:password@host:5432/calmmama
# STRIPE_SECRET_KEY=sk_test_your_secret_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
