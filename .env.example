# =============================================================================
# CalmMama Village — environment variables for local dev & Render deployment
# Copy to .env for local use. In Render: add the same keys under Environment.
# =============================================================================

# --- Runtime (Node production server) ----------------------------------------
# Render assigns PORT automatically — do not hardcode in production.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# --- Expo web build-time (embedded during `npm run build`) -------------------
# Render: buildCommand must be `npm run build` (expo export --platform web).
# Do NOT set startCommand to `expo start` or `npm start` — that serves dev Hermes bundles.
# Stripe publishable key for checkout UI (pk_live_... or pk_test_...)
# Must be set before `expo export` runs on Render so it is baked into the bundle.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Gemini API key for 2 AM Baby Oracle chat + Soul Sanctuary mama-friend notes.
# Optional — without it, both use a built-in warm local guide.
# EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Resend — welcome emails for Free Explorer + waitlist signup.
# EXPO_PUBLIC_RESEND_API_KEY=re_xxxxxxxx
# Optional verified sender (defaults to onboarding@calmmamavillage.com):
# RESEND_FROM=Calm Mama Village <onboarding@calmmamavillage.com>
# Audience / Segment ID for signup contacts (Resend dashboard → Audiences):
# EXPO_PUBLIC_RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Cron secret for /api/weekly-newsletter (Vercel Cron sends Bearer token automatically):
# CRON_SECRET=generate_a_long_random_string

# --- Web Push (PWA / iOS Home Screen) ----------------------------------------
# Generate with: npx web-push generate-vapid-keys
# Public key is baked into the web bundle (safe to expose).
# EXPO_PUBLIC_VAPID_PUBLIC_KEY=BPxxxxxxxx_your_public_key_here
# Private key stays server-only — never prefix with EXPO_PUBLIC_
# VAPID_PRIVATE_KEY=your_private_key_here
# Optional API to persist browser subscriptions after Enable Notifications:
# EXPO_PUBLIC_PUSH_SUBSCRIBE_URL=https://calmmamavillage.com/api/web-push/subscribe

# Stripe Checkout Sessions (monthly + annual) — enables promotion codes on hosted Checkout.
# Required on Vercel/Render for /api/stripe/checkout-session and /api/checkout:
# STRIPE_SECRET_KEY=sk_test_your_secret_here
# STRIPE_PRICE_MONTHLY=price_xxxxxxxx
# STRIPE_PRICE_ANNUAL=price_xxxxxxxx
# Optional override for success/cancel URLs (defaults to request host or calmmamavillage.com):
# STRIPE_CHECKOUT_ORIGIN=https://calmmamavillage.com
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Payment Link fallback success URLs:
#   https://calmmamavillage.com/app?upgraded=1&plan=monthly
#   https://calmmamavillage.com/app?upgraded=1&plan=annual
# DATABASE_URL=postgresql://user:password@host:5432/calmmama
